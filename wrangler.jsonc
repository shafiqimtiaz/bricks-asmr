{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bricks-asmr",
  "main": "./src/index.mjs",
  "account_id": "0f477dd8124eb3a644ac0c0e5f159ef0",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bricks-asmr",
      "database_id": "786779d1-68ed-49d0-a6ee-434d76143b85"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BrickRoom"
      }
    ]
  },
  "exports": {
    "BrickRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
